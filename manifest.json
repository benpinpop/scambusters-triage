{
  "manifest_version": 3,
  "name": "ScamBusters Triage",
  "version": "0.1.0",
  "description": "Triage suspected crypto-scam sites: detect and validate wallets, check and submit to ScamBusters, on-chain lookups, keyword scan.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "activeTab", "scripting", "sidePanel", "contextMenus"],
  "optional_host_permissions": ["<all_urls>"],
  "host_permissions": [
    "https://scambuster.intelligenceforgood.org/*",
    "https://urlscan.io/*",
    "https://api.etherscan.io/*",
    "https://blockchain.info/*",
    "https://apilist.tronscanapi.com/*",
    "https://xrplcluster.com/*",
    "https://api.xrpscan.com/*",
    "https://api.mainnet-beta.solana.com/*",
    "https://api.blockcypher.com/*",
    "https://bsc-dataseed.binance.org/*",
    "https://api.avax.network/*",
    "https://mainnet.optimism.io/*",
    "https://metadata.services.blockscout.com/*",
    "https://www.walletexplorer.com/*",
    "https://api.coingecko.com/*",
    "https://rdap.org/*",
    "https://data.iana.org/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/panel.html"
  },
  "action": {
    "default_title": "ScamBusters Triage",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; img-src 'self' https://urlscan.io; base-uri 'none'; form-action 'none'; frame-ancestors 'none'"
  }
}
